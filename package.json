{
  "name": "medusa-agent-skills",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "validate:markdown": "node scripts/validate-markdown-integrity.mjs",
    "validate:translations": "node scripts/validate-skill-translation-coverage.mjs",
    "validate:registries": "node scripts/validate-skill-accuracy-registry.mjs && node scripts/validate-agent-executor-registry.mjs && node scripts/validate-translated-skill-loss.mjs && node scripts/validate-json-schemas.mjs",
    "validate:governance": "node scripts/ci-guard.mjs && node scripts/ci-guard.mjs --framework-accuracy",
    "check": "npm test && npm run validate:markdown && npm run validate:translations && npm run validate:registries && npm run validate:governance"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ajv": "^8.17.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
