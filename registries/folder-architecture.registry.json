    "reports": {
      "allowed_subdirs": ["architecture", "ghost-files", "loss-investigation", "routing", "schema-inspection"],
      "structure": {
        "architecture": {
          "allowed_extensions": [".md", ".json", ".svg"]
        },
        "ghost-files": {
          "allowed_extensions": [".md", ".json", ".csv"]
        },
        "loss-investigation": {
