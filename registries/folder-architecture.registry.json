          { "name": "medusa-testing", "path": "plugins/learn-medusa/skills/medusa-testing", "required_files": ["SKILL.md", "SKILL.pt-br.md"] },
          { "name": "medusa-workflows", "path": "plugins/learn-medusa/skills/medusa-workflows", "required_files": ["SKILL.md", "SKILL.pt-br.md"] },
          { "name": "medusa-file-upload", "path": "plugins/learn-medusa/skills/medusa-file-upload", "required_files": ["SKILL.md", "SKILL.pt-br.md"] }
