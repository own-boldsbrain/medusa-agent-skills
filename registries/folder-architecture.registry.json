      "schemas/medusa-route.schema.json",
      "registries/plugins.registry.json",
      "registries/skills.registry.json",
      "scripts/ci-guard.mjs",
      "AGENTS.md",
      "CHANGELOG.md",
      "README.md",
      "ROADMAP.md",
      "DOD.md",
      "package.json"
    ],
    "excluded_paths": [
      "**/*.bak",
      "**/scratch/**",
      "**/node_modules/**",
