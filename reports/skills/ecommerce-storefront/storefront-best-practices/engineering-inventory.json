      "items": [
        {
          "use_case_id": "UC-001",
          "name": "Accessibility",
          "scenario": "- **CRITICAL: Cart count updates require `aria-live=\"polite\"`** - Screen readers won't announce without it\n- Ensure keyboard navigation for all cart/checkout interactions",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-002",
          "name": "Mobile",
          "scenario": "- **Sticky bottom elements MUST use `env(safe-area-inset-bottom)`** - iOS home indicator will cut off purchase buttons otherwise\n- 44px minimum touch targets for cart actions, variant selectors, quant",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-003",
          "name": "Performance",
          "scenario": "- **ALWAYS add `loading=\"lazy\"` to product images below fold** - Don't rely on browser defaults\n- Optimize product images for mobile (<500KB) - Most ecommerce traffic is mobile",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-004",
          "name": "Conversion Optimization",
          "scenario": "- Clear CTAs throughout shopping flow\n- Minimal friction in checkout (guest checkout if supported)\n- Trust signals (reviews, security badges, return policy) near purchase buttons\n- Clear pricing and s",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-005",
          "name": "SEO",
          "scenario": "- **Product schema (JSON-LD) required** - Critical for Google Shopping and rich snippets\n- Use [PageSpeed Insights](https://pagespeed.web.dev/) to measure Core Web Vitals",
          "status": "inferred"
        }
      ]
    },
