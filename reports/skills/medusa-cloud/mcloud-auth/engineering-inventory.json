      "items": [
        {
          "use_case_id": "UC-001",
          "name": "whoami",
          "scenario": "Show authenticated user, auth method, and active context (organization, project, environment).\n\n```bash\nmcloud whoami --json\n```\n\n**Options:**\n\n- `--json` — Output as JSON\n\n**Use to verify auth and sc",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-002",
          "name": "use",
          "scenario": "Set the active organization, project, and/or environment so subsequent commands skip those flags.\n\n```bash\nmcloud use \\\n  --organization <org-id> \\\n  --project <project-id-or-handle> \\\n  --environment",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-003",
          "name": "version",
          "scenario": "Print CLI version and platform metadata.\n\n```bash\nmcloud version --json\n```\n\n**Options:**\n\n- `--json` — Output as JSON",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-004",
          "name": "login",
          "scenario": "Authenticate with Medusa Cloud. Opens a browser to complete auth.\n\n> **TTY required.** Cannot be run in CI, Docker, or non-interactive environments. Use `MCLOUD_TOKEN` instead for non-interactive auth",
          "status": "inferred"
        },
        {
          "use_case_id": "UC-005",
          "name": "logout",
          "scenario": "Remove stored credentials.\n\n```bash\nmcloud logout --json\n```\n\n**Options:**\n\n- `--json` — Output as JSON",
          "status": "inferred"
        }
      ]
    },
    "does_and_does_not": {
      "status": "direct",
      "evidencia": "extraido_do_skill_md",
      "DOR": "Definir Faz / Não Faz",
      "DOD": "Faz / Não Faz validados e documentados",
