{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentExecutorRegistry",
  "description": "Registry tracking official agent executors, their allowed areas, forbidden areas, commands, and artifacts.",
  "type": "object",
  "properties": {
    "agent_executors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "executor_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "allowed_areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtime_allowed_areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accepted_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_contract": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended", "deprecated"]
          }
        },
        "required": [
          "executor_id",
          "name",
          "allowed_areas",
          "forbidden_areas",
          "accepted_artifacts",
          "allowed_commands",
          "evidence_contract",
          "status"
        ]
      }
    }
  },
  "required": [
    "agent_executors"
  ]
}
