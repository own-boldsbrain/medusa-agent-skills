{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchitectureValidationReportSchema",
  "description": "JSON schema validating the output of the Medusa Architecture Rules Engine",
  "type": "object",
  "properties": {
    "project_root": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "linter_version": {
      "type": "string"
    },
    "source_report": {
      "type": "object",
      "properties": {
        "scanner_version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "scanner_version",
        "path"
      ]
    },
    "passed": {
      "type": "boolean",
      "description": "True if there are no P0 violations."
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "category": {
            "type": "string",
            "enum": ["layering", "routing", "workflows", "general"]
          },
          "description": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "affected_entity": {
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "severity",
          "category",
          "description",
          "file",
          "evidence",
          "remediation"
        ]
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "project_root",
    "generated_at",
    "linter_version",
    "source_report",
    "passed",
    "violations",
    "summary"
  ]
}
