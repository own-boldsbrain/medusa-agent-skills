{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceRunSchema",
  "description": "JSON schema validating evidence run execution parameters and execution environments",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["GERADO", "VALIDADO", "REPROVADO", "APROVADO_COM_EVIDENCIAS"]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "files_analyzed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validations": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["passed", "failed", "skipped"]
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status",
    "started_at",
    "repository",
    "branch",
    "commit_sha",
    "files_analyzed",
    "files_changed",
    "commands_executed",
    "validations",
    "failures",
    "pending",
    "logs",
    "summary"
  ]
}
