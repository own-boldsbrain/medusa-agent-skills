{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCPToolSchema",
  "description": "Schema governing the structural validation of an MCP tool configuration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique identifier name of the tool, matching standard identifier patterns",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "description": {
      "type": "string",
      "description": "Detailed explanation of what the tool does, constraints, and parameters"
    },
    "input_schema": {
      "type": "object",
      "description": "Zod-compatible JSON Schema definition for the input arguments to the tool",
      "required": ["type", "properties"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["object"]
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output_format": {
      "type": "object",
      "properties": {
        "content_type": {
          "type": "string",
          "enum": ["application/json", "text/plain", "text/markdown"]
        },
        "schema": {
          "type": "object"
        }
      },
      "required": ["content_type"]
    }
  },
  "required": ["name", "description", "input_schema"]
}
