{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillIndexSchema",
  "description": "JSON schema validating compiled registry list of active skills",
  "type": "object",
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string"
          },
          "plugin": {
            "type": "string"
          },
          "skill_name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "frontmatter": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["name", "description"]
          },
          "source_language": {
            "type": "string"
          },
          "localized_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_agent_behaviors": {
            "type": "object",
            "properties": {
              "does": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "does_not": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["does", "does_not"]
          },
          "tools_expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "medusa_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_level": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "evidence_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "coverage_requirements": {
            "type": "object",
            "properties": {
              "min_files": {
                "type": "integer"
              },
              "min_percentage": {
                "type": "number"
              }
            },
            "required": ["min_files", "min_percentage"]
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "human_review_required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "active", "deprecated"]
          }
        },
        "required": [
          "skill_id",
          "plugin",
          "skill_name",
          "path",
          "title",
          "description",
          "frontmatter",
          "source_language",
          "localized_variants",
          "references",
          "expected_agent_behaviors",
          "tools_expected",
          "medusa_domains",
          "risk_level",
          "evidence_level",
          "coverage_requirements",
          "validation_commands",
          "human_review_required",
          "status"
        ]
      }
    }
  },
  "required": ["skills"]
}
